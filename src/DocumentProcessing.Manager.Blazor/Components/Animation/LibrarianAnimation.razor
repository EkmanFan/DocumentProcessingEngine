@implements IAsyncDisposable
@inject IStringLocalizer<LibrarianAnimation> Localizer

<div class="librarian-scene @ModeCssClass @MomentCssClass"
     role="img"
     aria-label="@AccessibleLabel"
     data-animation-mode="@ModeCssClass"
     data-celebration-sequence="@CelebrationSequence"
     data-reception-sequence="@ReceptionSequence"
     data-celebrating="@IsCelebrating.ToString().ToLowerInvariant()"
     data-receiving="@IsReceiving.ToString().ToLowerInvariant()">
    <div class="sprite-window" aria-hidden="true">
        <img class="librarian-sprite"
             src="@ImageSource"
             alt=""
             draggable="false" />

        <span class="scene-status">@CaptionTitle</span>
        <span class="state-emblem pause-emblem">Ⅱ</span>
        <span class="state-emblem sleep-emblem">Zzz</span>
        <span class="state-emblem unavailable-emblem">!</span>
    </div>

    <div class="scene-caption" aria-hidden="true">
        <span>@CaptionDetail</span>
    </div>
</div>

@code {
    #region Variables and Constants

    private const string
        DefaultImageSource =
            "/images/librarian-animation-v1.png";

    private static readonly TimeSpan
        MomentDuration =
            TimeSpan.FromMilliseconds(
                4000);

    private CancellationTokenSource?
        _momentCancellation;

    private Task?
        _momentTask;

    private long
        _observedCelebrationSequence;

    private long
        _observedReceptionSequence;

    private LibrarianMoment?
        _activeMoment;

    #endregion

    #region Parameters

    [Parameter]
    public LibrarianAnimationMode Mode { get; set; }

    [Parameter]
    public string? DocumentTitle { get; set; }

    [Parameter]
    public long CelebrationSequence { get; set; }

    [Parameter]
    public long ReceptionSequence { get; set; }

    [Parameter]
    public string? ReceptionDocumentTitle { get; set; }

    [Parameter]
    public string ImageSource { get; set; } =
        DefaultImageSource;

    #endregion

    #region Properties

    private bool IsCelebrating =>
        _activeMoment ==
        LibrarianMoment.Completion;

    private bool IsReceiving =>
        _activeMoment ==
        LibrarianMoment.Reception;

    private string? MomentCssClass =>
        _activeMoment switch
        {
            LibrarianMoment.Completion =>
                "scene-celebrating",
            LibrarianMoment.Reception =>
                "scene-celebrating scene-receiving",
            _ =>
                null
        };

    private string ModeCssClass =>
        Mode switch
        {
            LibrarianAnimationMode.Connecting =>
                "scene-connecting",
            LibrarianAnimationMode.Waiting =>
                "scene-waiting",
            LibrarianAnimationMode.Reading =>
                "scene-reading",
            LibrarianAnimationMode.Paused =>
                "scene-paused",
            LibrarianAnimationMode.Stopped =>
                "scene-stopped",
            LibrarianAnimationMode.Unavailable =>
                "scene-unavailable",
            _ =>
                throw new ArgumentOutOfRangeException(
                    nameof(Mode),
                    Mode,
                    "Unknown librarian animation mode.")
        };

    private string CaptionTitle =>
        _activeMoment switch
        {
            LibrarianMoment.Completion =>
                Localizer["TitleCelebrating"],
            LibrarianMoment.Reception =>
                Localizer["TitleReceived"],
            _ =>
                Mode switch
                {
                    LibrarianAnimationMode.Connecting =>
                        Localizer["TitleConnecting"],
                    LibrarianAnimationMode.Waiting =>
                        Localizer["TitleWaiting"],
                    LibrarianAnimationMode.Reading =>
                        Localizer["TitleReading"],
                    LibrarianAnimationMode.Paused =>
                        Localizer["TitlePaused"],
                    LibrarianAnimationMode.Stopped =>
                        Localizer["TitleStopped"],
                    LibrarianAnimationMode.Unavailable =>
                        Localizer["TitleUnavailable"],
                    _ =>
                        string.Empty
                }
        };

    private string CaptionDetail =>
        _activeMoment switch
        {
            LibrarianMoment.Completion =>
                Localizer["DetailCelebrating"],
            LibrarianMoment.Reception =>
                NormalizedReceptionDocumentTitle,
            _ =>
                Mode ==
                LibrarianAnimationMode.Reading
                    ? NormalizedDocumentTitle
                    : Mode switch
                {
                    LibrarianAnimationMode.Waiting =>
                        Localizer["DetailWaiting"],
                    LibrarianAnimationMode.Paused =>
                        Localizer["DetailPaused"],
                    LibrarianAnimationMode.Stopped =>
                        Localizer["DetailStopped"],
                    LibrarianAnimationMode.Unavailable =>
                        Localizer["DetailUnavailable"],
                    _ =>
                        Localizer["DetailConnecting"]
                }
        };

    private string AccessibleLabel =>
        Localizer[
            "AccessibleLabel",
            CaptionTitle,
            CaptionDetail];

    private string NormalizedDocumentTitle =>
        string.IsNullOrWhiteSpace(
            DocumentTitle)
            ? Localizer["DefaultDocumentTitle"]
            : DocumentTitle.Trim();

    private string NormalizedReceptionDocumentTitle =>
        string.IsNullOrWhiteSpace(
            ReceptionDocumentTitle)
            ? Localizer["DefaultDocumentTitle"]
            : ReceptionDocumentTitle.Trim();

    #endregion

    #region Methods Lifecycle

    protected override void OnParametersSet()
    {
        if (!Enum.IsDefined(
                Mode))
        {
            throw new ArgumentOutOfRangeException(
                nameof(Mode),
                Mode,
                "Unknown librarian animation mode.");
        }

        if (CelebrationSequence <
            0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(CelebrationSequence),
                CelebrationSequence,
                "The celebration sequence cannot be negative.");
        }

        if (ReceptionSequence <
            0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(ReceptionSequence),
                ReceptionSequence,
                "The reception sequence cannot be negative.");
        }

        if (string.IsNullOrWhiteSpace(
                ImageSource))
        {
            throw new ArgumentException(
                "The librarian sprite image source cannot be empty.",
                nameof(ImageSource));
        }

        var receptionRequested =
            ReceptionSequence >
            _observedReceptionSequence;

        var completionRequested =
            CelebrationSequence >
            _observedCelebrationSequence;

        _observedReceptionSequence =
            Math.Max(
                _observedReceptionSequence,
                ReceptionSequence);

        _observedCelebrationSequence =
            Math.Max(
                _observedCelebrationSequence,
                CelebrationSequence);

        if (receptionRequested)
        {
            StartMoment(
                LibrarianMoment.Reception);

            return;
        }

        if (completionRequested)
        {
            StartMoment(
                LibrarianMoment.Completion);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_momentCancellation is null)
        {
            return;
        }

        await _momentCancellation
            .CancelAsync();

        if (_momentTask is not null)
        {
            try
            {
                await _momentTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _momentCancellation.Dispose();
    }

    #endregion

    #region Methods Animation

    private void StartMoment(
        LibrarianMoment moment)
    {
        _momentCancellation?.Cancel();
        _momentCancellation?.Dispose();

        _momentCancellation =
            new CancellationTokenSource();

        _activeMoment =
            moment;

        _momentTask =
            CompleteMomentAsync(
                _momentCancellation.Token);
    }

    private async Task CompleteMomentAsync(
        CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(
                MomentDuration,
                cancellationToken);
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
            return;
        }

        _activeMoment =
            null;

        await InvokeAsync(
            StateHasChanged);
    }

    #endregion

    #region Types

    private enum LibrarianMoment
    {
        Completion,
        Reception
    }

    #endregion
}
