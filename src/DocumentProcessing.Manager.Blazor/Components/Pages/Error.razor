@page "/error"
@inject IStringLocalizer<StandaloneUiResources> Localizer

<PageTitle>@Localizer["ErrorPageTitle"]</PageTitle>

<main class="standalone-message">
    <p class="eyebrow">@Localizer["WorkshopTitle"]</p>
    <h1>@Localizer["UnexpectedErrorTitle"]</h1>
    <p>@Localizer["UnexpectedErrorDetail"]</p>
    <a href="/">@Localizer["ReturnToWorkshop"]</a>
</main>
