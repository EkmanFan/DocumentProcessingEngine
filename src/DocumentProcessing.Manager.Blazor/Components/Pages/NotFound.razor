@page "/not-found"
@inject IStringLocalizer<StandaloneUiResources> Localizer

<PageTitle>@Localizer["NotFoundPageTitle"]</PageTitle>

<main class="standalone-message">
    <p class="eyebrow">404</p>
    <h1>@Localizer["NotFoundTitle"]</h1>
    <p>@Localizer["NotFoundDetail"]</p>
    <a href="/">@Localizer["ReturnToWorkshop"]</a>
</main>
