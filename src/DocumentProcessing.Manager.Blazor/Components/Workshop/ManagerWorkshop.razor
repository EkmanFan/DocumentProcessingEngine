@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@inject IManagerHostClient ManagerClient
@inject IManagerResultClient ResultClient
@inject DocumentProcessing.Manager.Blazor.Configuration.ManagerApiOptions Options
@inject ILogger<ManagerWorkshop> Logger
@inject IStringLocalizer<ManagerWorkshop> Localizer
@inject IJSRuntime JavaScript
@inject IManagerVisualDestinationPicker VisualDestinationPicker
@inject ManagerWorkshopUploadService UploadService

<main class="workshop-shell">
    <header class="workshop-header">
        <div class="brand-block">
            <div class="brand-mark" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <div>
                <p class="eyebrow">DPEngine Manager</p>
                <h1>@Localizer["WorkshopTitle"]</h1>
            </div>
        </div>

        <div class="manager-toolbar">
            <div class="manager-state @StateCssClass" aria-live="polite">
                <span class="state-indicator" aria-hidden="true"></span>
                <span>@StateLabel</span>
            </div>

            <div class="control-group" aria-label="@(Localizer["ManagerControlsLabel"])">
                @if (_snapshot?.State == ManagerHostState.Stopped)
                {
                    <button class="control-button control-primary"
                            type="button"
                            disabled="@_commandRunning"
                            @onclick="() => ExecuteControlAsync(ManagerControlAction.Start)">
                        @Localizer["Start"]
                    </button>
                }
                else if (_snapshot?.State == ManagerHostState.Paused)
                {
                    <button class="control-button control-primary"
                            type="button"
                            disabled="@_commandRunning"
                            @onclick="() => ExecuteControlAsync(ManagerControlAction.Resume)">
                        @Localizer["Resume"]
                    </button>
                }
                else
                {
                    <button class="control-button control-primary"
                            type="button"
                            disabled="@(_commandRunning || _snapshot is null)"
                            @onclick="() => ExecuteControlAsync(ManagerControlAction.Pause)">
                        @Localizer["Pause"]
                    </button>
                }

                <button class="control-button control-secondary"
                        type="button"
                        disabled="@(_commandRunning || _snapshot is null || _snapshot.State == ManagerHostState.Stopped)"
                        @onclick="() => ExecuteControlAsync(ManagerControlAction.Stop)">
                    @Localizer["Stop"]
                </button>
            </div>

            <label class="settings-button split-upload-button"
                   title="@(Localizer["OpenSplit"])"
                   aria-label="@(Localizer["OpenSplit"])">
                <span aria-hidden="true">✂</span>
                @Localizer["SplitDocument"]
                <InputFile class="split-file-input"
                           disabled="@_commandRunning"
                           accept=".pdf,.epub,application/pdf,application/epub+zip"
                           OnChange="PrepareUploadedSplitAsync" />
            </label>

            <button class="settings-button"
                    type="button"
                    disabled="@(_settings is null)"
                    title="@(Localizer["OpenSettings"])"
                    aria-label="@(Localizer["OpenSettings"])"
                    @onclick="OpenSettings">
                <span aria-hidden="true">⚙</span>
                @Localizer["Settings"]
            </button>
        </div>
    </header>

    @if (_error is not null)
    {
        <div class="connection-alert" role="alert">
            <div>
                <strong>@ErrorTitle</strong>
                <span>@ErrorMessage</span>
            </div>
            <button type="button" @onclick="RefreshFromUserAsync">@Localizer["Retry"]</button>
        </div>
    }

    <section class="workshop-grid" aria-busy="@(_snapshot is null)">
        <section class="work-column queue-column" aria-labelledby="queue-title">
            <div class="column-heading">
                <div>
                    <p class="column-kicker">@Localizer["PendingKicker"]</p>
                    <h2 id="queue-title">@Localizer["PendingTitle"]</h2>
                </div>
                <div class="column-heading-actions">
                    <span class="count-badge">@PendingCount</span>
                    @if (_snapshot is not null && _snapshot.PendingItems.Count > 0)
                    {
                        <button class="clear-queue-button"
                                type="button"
                                disabled="@_commandRunning"
                                @onclick="ClearPendingQueueAsync">
                            @Localizer["ClearQueue"]
                        </button>
                    }
                </div>
            </div>

            <div class="column-rule"></div>

            @if (_snapshot is null)
            {
                <div class="skeleton-list" aria-label="@(Localizer["QueueLoadingLabel"])">
                    <div></div>
                    <div></div>
                    <div></div>
                </div>
            }
            else if (_snapshot.PendingItems.Count == 0)
            {
                <div class="empty-state">
                    <span class="empty-icon" aria-hidden="true">✓</span>
                    <strong>@Localizer["QueueEmptyTitle"]</strong>
                    <p>@Localizer["QueueEmptyDetail"]</p>
                </div>
            }
            else
            {
                <ol class="work-list queue-list" @ref="_queueList">
                    @for (var index = 0; index < _snapshot.PendingItems.Count; index++)
                    {
                        var item = _snapshot.PendingItems[index];

                        <li @key="item.UnitId"
                            class="work-item pending-item"
                            data-queue-drop-unit-id="@item.UnitId">
                            <span class="queue-drag-handle"
                                  data-queue-drag-unit-id="@item.UnitId"
                                  title="@(Localizer["DragQueueItemLabel", item.DocumentTitle])"
                                  aria-hidden="true">⠿</span>
                            <span class="queue-position">@item.QueuePosition</span>
                            <div class="work-copy">
                                <strong title="@item.OriginalFileName">@item.DocumentTitle</strong>
                                <span>@FormatScope(item.Scope)</span>
                            </div>
                            <div class="queue-actions">
                                <div class="queue-metadata">
                                    <span class="dispatch-badge @(item.DispatchState == ManagerQueueItemDispatchState.Shelved ? "dispatch-shelved" : "dispatch-ready")">
                                        @(item.DispatchState == ManagerQueueItemDispatchState.Shelved
                                            ? Localizer["ShelvedStatus"]
                                            : Localizer["ReadyStatus"])
                                    </span>
                                    @if (item.AttemptNumber > 1)
                                    {
                                        <span class="attempt-badge">@Localizer["AttemptLabel", item.AttemptNumber]</span>
                                    }
                                </div>
                                <div class="queue-command-group">
                                    @if (item.DispatchState == ManagerQueueItemDispatchState.Shelved)
                                    {
                                        <button class="queue-run-button"
                                                type="button"
                                                disabled="@_commandRunning"
                                                title="@(Localizer["RunQueuedItemLabel", item.DocumentTitle])"
                                                aria-label="@(Localizer["RunQueuedItemLabel", item.DocumentTitle])"
                                                @onclick="() => ReleaseProcessingUnitAsync(item.UnitId)">
                                            @Localizer["RunQueuedItem"]
                                        </button>
                                    }
                                    <details class="action-menu">
                                        <summary title="@(Localizer["MoreActionsLabel", item.DocumentTitle])"
                                                 aria-label="@(Localizer["MoreActionsLabel", item.DocumentTitle])">…</summary>
                                        <div class="action-menu-panel">
                                            @if (item.Scope.Kind == ManagerWorkItemScopeKind.WholeDocument)
                                            {
                                                <button type="button"
                                                        disabled="@_commandRunning"
                                                        title="@(Localizer["SplitQueuedItemLabel", item.DocumentTitle])"
                                                        @onclick="() => OpenSplitAsync(item)">
                                                    @Localizer["SplitQueuedItem"]
                                                </button>
                                            }
                                            <button type="button"
                                                    disabled="@(_commandRunning || index == 0)"
                                                    title="@(Localizer["MoveEarlierLabel", item.DocumentTitle])"
                                                    @onclick="() => MoveQueueItemAsync(item.UnitId, -1)">
                                                @Localizer["MoveEarlier"]
                                            </button>
                                            <button type="button"
                                                    disabled="@(_commandRunning || index == _snapshot.PendingItems.Count - 1)"
                                                    title="@(Localizer["MoveLaterLabel", item.DocumentTitle])"
                                                    @onclick="() => MoveQueueItemAsync(item.UnitId, 1)">
                                                @Localizer["MoveLater"]
                                            </button>
                                            <button class="destructive-action"
                                                    type="button"
                                                    disabled="@_commandRunning"
                                                    title="@(Localizer["RemovePendingLabel", item.DocumentTitle])"
                                                    @onclick="() => RemovePendingProcessingUnitAsync(item)">
                                                @Localizer["RemovePending"]
                                            </button>
                                        </div>
                                    </details>
                                </div>
                            </div>
                        </li>
                    }
                </ol>
            }

            <footer class="column-footer">
                <span>@Localizer["GlobalQueue"]</span>
                <span>v@(QueueVersion)</span>
            </footer>
        </section>

        <section class="work-column active-column" aria-labelledby="active-title">
            <div class="column-heading active-heading">
                <div>
                    <p class="column-kicker">@Localizer["ActiveKicker"]</p>
                    <h2 id="active-title">@Localizer["ActiveTitle"]</h2>
                </div>
                @if (_snapshot?.ActiveItem is not null)
                {
                    <span class="live-badge"><span></span>@Localizer["ActiveBadge"]</span>
                }
            </div>

            @if (_snapshot?.ActiveItem is { } activeItem)
            {
                <div class="current-document current-document-active"
                     aria-live="polite"
                     role="progressbar"
                     aria-label="@(Localizer["ProcessingProgressAriaLabel", activeItem.DocumentTitle])"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="@ActiveProgressPercentage(activeItem)"
                     style="@ActiveProgressStyle(activeItem)">
                    <span class="current-document-progress" aria-hidden="true"></span>
                    <div class="document-monogram" aria-hidden="true">@GetMonogram(activeItem.DocumentTitle)</div>
                    <div class="current-document-copy">
                        <small class="processing-stage">@FormatProgress(activeItem.Progress)</small>
                        <strong title="@activeItem.DocumentTitle">@activeItem.DocumentTitle</strong>
                        <span>@FormatScope(activeItem.Scope)</span>
                    </div>
                </div>
            }
            else
            {
                <div class="current-document" aria-live="polite">
                    <div class="document-monogram document-monogram-empty" aria-hidden="true">—</div>
                    <div class="current-document-copy">
                        <strong>@Localizer["NoActiveTitle"]</strong>
                        <span>@IdleMessage</span>
                    </div>
                </div>
            }

            <ManagerDocumentDropZone DocumentSubmitted="HandleDocumentSubmittedAsync"
                                     SubmissionBehavior="@CurrentSubmissionBehavior">
                <LibrarianAnimation Mode="@LibrarianMode"
                                    DocumentTitle="@_snapshot?.ActiveItem?.DocumentTitle"
                                    CelebrationSequence="@_animationTracker.CelebrationSequence"
                                    ReceptionSequence="@_receptionSequence"
                                    ReceptionDocumentTitle="@_receivedDocumentTitle" />
            </ManagerDocumentDropZone>

            <footer class="active-footer">
                <span>@Localizer["SequentialProcessingDetail"]</span>
                <span>@LastRefreshLabel</span>
            </footer>
        </section>

        <section class="work-column completed-column" aria-labelledby="completed-title">
            <div class="column-heading">
                <div>
                    <p class="column-kicker">@Localizer["CompletedKicker"]</p>
                    <h2 id="completed-title">@Localizer["CompletedTitle"]</h2>
                </div>
                <span class="count-badge count-complete">@CompletedCount</span>
            </div>

            <div class="column-rule"></div>

            @if (_snapshot is null)
            {
                <div class="skeleton-list" aria-label="@(Localizer["CompletedLoadingLabel"])">
                    <div></div>
                    <div></div>
                    <div></div>
                </div>
            }
            else if (_snapshot.CompletedItems.Count == 0)
            {
                <div class="empty-state">
                    <span class="empty-icon empty-icon-book" aria-hidden="true">◇</span>
                    <strong>@Localizer["NoResultsTitle"]</strong>
                    <p>@Localizer["NoResultsDetail"]</p>
                </div>
            }
            else
            {
                <div class="completed-scroll-region" @ref="_completedScrollRegion">
                    <ol class="work-list completed-list">
                        @foreach (var item in _snapshot.CompletedItems)
                        {
                            <li class="work-item completed-item @(item.Status == ManagerQueueItemStatus.Failed ? "failed-item" : null)">
                                <span class="result-indicator" aria-hidden="true">
                                    @(item.Status == ManagerQueueItemStatus.Failed ? "!" : "✓")
                                </span>
                                <div class="work-copy">
                                    <strong title="@item.OriginalFileName">@item.DocumentTitle</strong>
                                    <span>@FormatScope(item.Scope)</span>
                                    <time datetime="@item.UpdatedAtUtc.ToString("O")">@FormatCompletedAt(item.UpdatedAtUtc)</time>
                                    @if (item.Status == ManagerQueueItemStatus.Failed)
                                    {
                                        <span class="processing-failure-message"
                                              title="@(Localizer["ProcessingFailureLabel", item.FailureMessage!])">
                                            @item.FailureMessage
                                        </span>
                                    }
                                </div>
                                <div class="result-actions">
                                    <span class="result-status">
                                        @(item.Status == ManagerQueueItemStatus.Failed
                                            ? Localizer["FailedStatus"]
                                            : Localizer["CompletedStatus"])
                                    </span>
                                    <details class="action-menu">
                                        <summary title="@(Localizer["MoreActionsLabel", item.DocumentTitle])"
                                                 aria-label="@(Localizer["MoreActionsLabel", item.DocumentTitle])">…</summary>
                                        <div class="action-menu-panel">
                                            @if (item.Status == ManagerQueueItemStatus.Succeeded)
                                            {
                                                <button type="button"
                                                        disabled="@(_downloadingResultUnitId is not null)"
                                                        title="@(Localizer["DownloadResultLabel", item.DocumentTitle])"
                                                        @onclick="() => DownloadResultAsync(item)">
                                                    @(_downloadingResultUnitId == item.UnitId
                                                        ? Localizer["DownloadingResult"]
                                                        : Localizer["DownloadResult"])
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        disabled="@_commandRunning"
                                                        title="@(Localizer[GetRetryLabelKey(item.Scope), item.DocumentTitle])"
                                                        @onclick="() => RetryFailedProcessingUnitAsync(item.UnitId)">
                                                    @Localizer[GetRetryTextKey(item.Scope)]
                                                </button>
                                            }
                                            <button type="button"
                                                    disabled="@_commandRunning"
                                                    title="@(Localizer["HideProcessedLabel", item.DocumentTitle])"
                                                    @onclick="() => HideTerminalProcessingUnitAsync(item)">
                                                @Localizer["HideProcessed"]
                                            </button>
                                            <button class="destructive-action"
                                                    type="button"
                                                    disabled
                                                    title="@(Localizer["PurgeAdminUnavailableLabel"])">
                                                @Localizer["PurgeProcessed"]
                                            </button>
                                        </div>
                                    </details>
                                    @if (_resultDownloadFailureUnitId == item.UnitId)
                                    {
                                        <span class="result-download-error" role="alert">
                                            @_resultDownloadFailureMessage
                                        </span>
                                    }
                                </div>
                            </li>
                        }
                    </ol>
                </div>
            }

            <footer class="column-footer">
                <button class="archive-open-button"
                        type="button"
                        @onclick="OpenArchiveAsync">
                    @Localizer["OpenArchives"]
                </button>
                <span>@CompletedResultCountLabel</span>
            </footer>
        </section>
    </section>
</main>

@if (_splitPreview is not null)
{
    <ManagerDocumentSplitDialog Preview="_splitPreview"
                                Busy="_splitBusy"
                                Cancel="CloseSplit"
                                Apply="ApplySplitAsync" />
}

@if (_settingsOpen)
{
    <div class="settings-overlay" role="presentation">
        <section class="settings-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="manager-settings-title">
            <header class="settings-dialog-header">
                <div>
                    <p class="column-kicker">DPEngine Manager</p>
                    <h2 id="manager-settings-title">@Localizer["SettingsTitle"]</h2>
                </div>
                <button class="settings-close"
                        type="button"
                        disabled="@_settingsSaving"
                        title="@(Localizer["CloseSettings"])"
                        aria-label="@(Localizer["CloseSettings"])"
                        @onclick="CloseSettings">×</button>
            </header>

            <div class="settings-field">
                <span class="settings-label">@Localizer["DefaultSubmissionBehavior"]</span>
                <div class="settings-choice"
                     role="group"
                     aria-label="@(Localizer["DefaultSubmissionBehavior"])">
                    <button type="button"
                            class="@SettingsBehaviorButtonClass(ManagerDocumentSubmissionBehavior.Shelve)"
                            disabled="@_settingsSaving"
                            aria-pressed="@FormatSettingsPressedState(ManagerDocumentSubmissionBehavior.Shelve)"
                            @onclick="() => SelectSettingsBehavior(ManagerDocumentSubmissionBehavior.Shelve)">
                        @Localizer["ShelveBehavior"]
                    </button>
                    <button type="button"
                            class="@SettingsBehaviorButtonClass(ManagerDocumentSubmissionBehavior.Run)"
                            disabled="@_settingsSaving"
                            aria-pressed="@FormatSettingsPressedState(ManagerDocumentSubmissionBehavior.Run)"
                            @onclick="() => SelectSettingsBehavior(ManagerDocumentSubmissionBehavior.Run)">
                        @Localizer["RunBehavior"]
                    </button>
                </div>
                <small>@Localizer["DefaultSubmissionBehaviorDetail"]</small>
            </div>

            <div class="settings-field">
                <label class="settings-label" for="visual-destination-root">
                    @Localizer["VisualDestination"]
                </label>
                <div class="settings-path-row">
                    <input id="visual-destination-root"
                           type="text"
                           spellcheck="false"
                           autocomplete="off"
                           disabled="@_settingsSaving"
                           placeholder="@(Localizer["VisualDestinationPlaceholder"])"
                           @bind="_settingsDraftVisualRoot"
                           @bind:event="oninput" />
                    <button type="button"
                            disabled="@(_settingsSaving || _pickerRunning)"
                            @onclick="BrowseVisualDestinationAsync">
                        @(_pickerRunning
                            ? Localizer["Browsing"]
                            : Localizer["Browse"])
                    </button>
                </div>
                <small>@Localizer["VisualDestinationDetail"]</small>
            </div>

            <div class="settings-field settings-retention-field">
                <label class="settings-label" for="completed-retention-days">
                    @Localizer["CompletedRetention"]
                </label>
                <input id="completed-retention-days"
                       type="number"
                       min="@ManagerWorkshopSettings.MinimumCompletedRetentionDays"
                       max="@ManagerWorkshopSettings.MaximumCompletedRetentionDays"
                       disabled="@_settingsSaving"
                       @bind="_settingsDraftRetentionDays"
                       @bind:event="oninput" />
                <small>@Localizer["CompletedRetentionDetail"]</small>
            </div>

            @if (!string.IsNullOrWhiteSpace(_settingsFailure))
            {
                <div class="settings-error" role="alert">@_settingsFailure</div>
            }

            <footer class="settings-actions">
                <button class="settings-cancel"
                        type="button"
                        disabled="@_settingsSaving"
                        @onclick="CloseSettings">
                    @Localizer["Cancel"]
                </button>
                <button class="settings-save"
                        type="button"
                        disabled="@(_settingsSaving || string.IsNullOrWhiteSpace(_settingsDraftVisualRoot) || _settingsDraftRetentionDays is < ManagerWorkshopSettings.MinimumCompletedRetentionDays or > ManagerWorkshopSettings.MaximumCompletedRetentionDays)"
                        @onclick="SaveSettingsAsync">
                    @(_settingsSaving
                        ? Localizer["Saving"]
                        : Localizer["Save"])
                </button>
            </footer>
        </section>
    </div>
}

@if (_archiveOpen)
{
    <div class="settings-overlay archive-overlay" role="presentation">
        <section class="settings-dialog archive-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="manager-archive-title">
            <header class="settings-dialog-header">
                <div>
                    <p class="column-kicker">DPEngine Manager</p>
                    <h2 id="manager-archive-title">@Localizer["ArchivesTitle"]</h2>
                </div>
                <button class="settings-close"
                        type="button"
                        title="@(Localizer["CloseArchives"])"
                        aria-label="@(Localizer["CloseArchives"])"
                        @onclick="CloseArchive">×</button>
            </header>

            <div class="archive-filters">
                <label>
                    <span>@Localizer["ArchiveTitleFilter"]</span>
                    <input type="search"
                           autocomplete="off"
                           placeholder="@(Localizer["ArchiveTitlePlaceholder"])"
                           @bind="_archiveTitleFilter"
                           @bind:event="oninput" />
                </label>
                <label>
                    <span>@Localizer["ArchiveFromDate"]</span>
                    <input type="date"
                           value="@_archiveFromDate"
                           @onchange="eventArgs => _archiveFromDate = eventArgs.Value?.ToString()" />
                </label>
                <label>
                    <span>@Localizer["ArchiveToDate"]</span>
                    <input type="date"
                           value="@_archiveToDate"
                           @onchange="eventArgs => _archiveToDate = eventArgs.Value?.ToString()" />
                </label>
                <label>
                    <span>@Localizer["ArchiveSort"]</span>
                    <select @bind="_archiveSort">
                        <option value="@ManagerArchiveSort.CompletedNewest">@Localizer["ArchiveNewest"]</option>
                        <option value="@ManagerArchiveSort.CompletedOldest">@Localizer["ArchiveOldest"]</option>
                        <option value="@ManagerArchiveSort.TitleAscending">@Localizer["ArchiveTitleAscending"]</option>
                        <option value="@ManagerArchiveSort.TitleDescending">@Localizer["ArchiveTitleDescending"]</option>
                    </select>
                </label>
                <button class="archive-filter-button"
                        type="button"
                        disabled="@_archiveLoading"
                        @onclick="ApplyArchiveFiltersAsync">
                    @Localizer["ApplyArchiveFilters"]
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_archiveFailure))
            {
                <div class="settings-error" role="alert">@_archiveFailure</div>
            }

            <div class="archive-results" aria-busy="@_archiveLoading">
                @if (_archiveLoading)
                {
                    <div class="skeleton-list archive-skeleton"><div></div><div></div><div></div></div>
                }
                else if (_archivePage?.Items.Count is not > 0)
                {
                    <div class="empty-state archive-empty">
                        <span class="empty-icon empty-icon-book" aria-hidden="true">◇</span>
                        <strong>@Localizer["ArchiveEmptyTitle"]</strong>
                        <p>@Localizer["ArchiveEmptyDetail"]</p>
                    </div>
                }
                else
                {
                    <ol class="work-list archive-list">
                        @foreach (var item in _archivePage.Items)
                        {
                            <li class="work-item completed-item @(item.Status == ManagerQueueItemStatus.Failed ? "failed-item" : null)">
                                <span class="result-indicator" aria-hidden="true">@(item.Status == ManagerQueueItemStatus.Failed ? "!" : "✓")</span>
                                <div class="work-copy">
                                    <strong title="@item.OriginalFileName">@item.DocumentTitle</strong>
                                    <span>@FormatScope(item.Scope)</span>
                                    <time datetime="@item.UpdatedAtUtc.ToString("O")">@FormatCompletedAt(item.UpdatedAtUtc)</time>
                                    @if (item.Status == ManagerQueueItemStatus.Failed)
                                    {
                                        <span class="processing-failure-message">@item.FailureMessage</span>
                                    }
                                </div>
                                <div class="result-actions">
                                    <span class="result-status">@(item.Status == ManagerQueueItemStatus.Failed ? Localizer["FailedStatus"] : Localizer["CompletedStatus"])</span>
                                    <details class="action-menu">
                                        <summary title="@(Localizer["MoreActionsLabel", item.DocumentTitle])"
                                                 aria-label="@(Localizer["MoreActionsLabel", item.DocumentTitle])">…</summary>
                                        <div class="action-menu-panel">
                                            @if (item.Status == ManagerQueueItemStatus.Succeeded)
                                            {
                                                <button type="button"
                                                        disabled="@(_downloadingResultUnitId is not null)"
                                                        title="@(Localizer["DownloadResultLabel", item.DocumentTitle])"
                                                        @onclick="() => DownloadResultAsync(item)">
                                                    @(_downloadingResultUnitId == item.UnitId ? Localizer["DownloadingResult"] : Localizer["DownloadResult"])
                                                </button>
                                            }
                                            <button type="button"
                                                    disabled="@_commandRunning"
                                                    title="@(Localizer["HideProcessedLabel", item.DocumentTitle])"
                                                    @onclick="() => HideTerminalProcessingUnitAsync(item)">
                                                @Localizer["HideProcessed"]
                                            </button>
                                            <button class="destructive-action"
                                                    type="button"
                                                    disabled
                                                    title="@(Localizer["PurgeAdminUnavailableLabel"])">
                                                @Localizer["PurgeProcessed"]
                                            </button>
                                        </div>
                                    </details>
                                </div>
                            </li>
                        }
                    </ol>
                }
            </div>

            <footer class="archive-pagination">
                <span>@ArchiveResultSummary</span>
                <div>
                    <button type="button"
                            disabled="@(_archiveLoading || !ArchiveHasPreviousPage)"
                            @onclick="LoadPreviousArchivePageAsync">@Localizer["PreviousPage"]</button>
                    <button type="button"
                            disabled="@(_archiveLoading || !ArchiveHasNextPage)"
                            @onclick="LoadNextArchivePageAsync">@Localizer["NextPage"]</button>
                </div>
            </footer>
        </section>
    </div>
}

@code {
    #region Variables and Constants

    private readonly CancellationTokenSource
        _lifetime =
            new();

    private const string
        EmbeddedResultDownloadModulePath =
            "./_content/DocumentProcessing.Manager.Blazor/js/manager-result-download.js";

    private const string
        StandaloneResultDownloadModulePath =
            "./js/manager-result-download.js";

    private readonly ManagerWorkshopAnimationTracker
        _animationTracker =
            new();

    private readonly SemaphoreSlim
        _refreshGate =
            new(
                initialCount:
                    1,
                maxCount:
                    1);

    private ManagerWorkshopSnapshot?
        _snapshot;

    private ManagerWorkshopSettings?
        _settings;

    private bool
        _settingsOpen;

    private ManagerSplitPreviewContract?
        _splitPreview;

    private bool
        _splitBusy;

    private bool
        _splitRunAfterApply;

    private bool
        _settingsSaving;

    private bool
        _pickerRunning;

    private ManagerDocumentSubmissionBehavior
        _settingsDraftBehavior =
            ManagerDocumentSubmissionBehavior.Shelve;

    private string?
        _settingsDraftVisualRoot;

    private int
        _settingsDraftRetentionDays =
            ManagerWorkshopSettings.DefaultCompletedRetentionDays;

    private string?
        _settingsFailure;

    private bool
