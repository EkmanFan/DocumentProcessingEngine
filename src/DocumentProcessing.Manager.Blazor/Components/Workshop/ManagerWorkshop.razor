    private string FormatProgress(
        ManagerProcessingProgressView? progress)
    {
        if (progress is null)
        {
            return Localizer["ProgressLoadingSource"];
        }

        var stage =
            progress.Stage switch
            {
                ManagerProcessingProgressStage.LoadingSource =>
                    Localizer["ProgressLoadingSource"],
                ManagerProcessingProgressStage.PreparingSource =>
                    Localizer["ProgressPreparingSource"],
                ManagerProcessingProgressStage.InspectingFormat =>
                    Localizer["ProgressInspectingFormat"],
                ManagerProcessingProgressStage.Planning =>
                    Localizer["ProgressPlanning"],
                ManagerProcessingProgressStage.AnalyzingContent =>
                    Localizer["ProgressAnalyzingContent"],
                ManagerProcessingProgressStage.ProcessingContent =>
                    Localizer["ProgressProcessingContent"],
                ManagerProcessingProgressStage.AssemblingResult =>
                    Localizer["ProgressAssemblingResult"],
                ManagerProcessingProgressStage.StoringResult =>
                    Localizer["ProgressStoringResult"],
                ManagerProcessingProgressStage.PublishingResult =>
                    Localizer["ProgressPublishingResult"],
                _ =>
                    throw new ArgumentOutOfRangeException(
                        nameof(progress),
                        progress.Stage,
                        "Unknown processing-progress stage.")
            };

        return progress.CompletedUnitCount is { } completed &&
               progress.TotalUnitCount is { } total
            ? Localizer[
                "ProgressWithUnits",
                stage,
                completed,
                total]
            : stage;
    }

