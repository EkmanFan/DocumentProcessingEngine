    private async Task RemovePendingProcessingUnitAsync(
        ManagerWorkItemView item)
    {
        if (_snapshot is null ||
            !await ConfirmAsync("RemovePendingConfirmation", item.DocumentTitle))
        {
            return;
        }

        var expectedVersion = _snapshot.QueueVersion;
        await ExecuteQueueMutationAsync(
            cancellationToken =>
                ManagerClient.RemovePendingProcessingUnitAsync(
                    item.UnitId,
                    expectedVersion,
                    cancellationToken),
            "remove-pending");
    }

    private async Task ClearPendingQueueAsync()
    {
        if (_snapshot is null ||
            _snapshot.PendingItems.Count == 0 ||
            !await ConfirmAsync("ClearQueueConfirmation", _snapshot.PendingItems.Count))
        {
            return;
        }

        var expectedVersion = _snapshot.QueueVersion;
        await ExecuteQueueMutationAsync(
            cancellationToken =>
                ManagerClient.ClearPendingQueueAsync(
                    expectedVersion,
                    cancellationToken),
            "clear-pending");
    }

    private async Task HideTerminalProcessingUnitAsync(
        ManagerWorkItemView item)
    {
        if (_snapshot is null ||
            !await ConfirmAsync("HideProcessedConfirmation", item.DocumentTitle))
        {
            return;
        }

        var expectedVersion = _snapshot.QueueVersion;
        await ExecuteQueueMutationAsync(
            cancellationToken =>
                ManagerClient.HideTerminalProcessingUnitAsync(
                    item.UnitId,
                    expectedVersion,
                    cancellationToken),
            "hide-terminal");

        if (_archiveOpen && _error is null)
        {
            await LoadArchivePageAsync(_archivePage?.Offset ?? 0);
        }
    }

    private async ValueTask<bool> ConfirmAsync(
        string resourceKey,
        object argument) =>
        await JavaScript.InvokeAsync<bool>(
            "confirm",
            _lifetime.Token,
            Localizer[resourceKey, argument].Value);

    private async Task ExecuteQueueMutationAsync(
        Func<CancellationToken, ValueTask> mutation,
        string operation)
    {
        if (_commandRunning)
        {
            return;
        }

        _commandRunning =
            true;

        _error =
            null;

        try
        {
            await mutation(
                _lifetime.Token);

            await RefreshAsync(
                notifyRenderer:
                    false,
                waitForTurn:
                    true,
                _lifetime.Token);
        }
        catch (OperationCanceledException)
            when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Manager queue {ManagerQueueOperation} failed.",
                operation);

            _error =
                ManagerWorkshopError.Queue;
        }
        finally
        {
            _commandRunning =
                false;
        }
    }

    private Task RefreshFromUserAsync() =>
        RefreshAsync(
            notifyRenderer:
                false,
            waitForTurn:
                true,
            _lifetime.Token);

    #endregion

    #region Methods Refresh

    private async Task RefreshPeriodicallyAsync(
        CancellationToken cancellationToken)
    {
        try
        {
            while (_refreshTimer is not null &&
                   await _refreshTimer.WaitForNextTickAsync(
                       cancellationToken))
            {
                await RefreshAsync(
                    notifyRenderer:
                        true,
                    waitForTurn:
                        false,
                    cancellationToken);
            }
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task RefreshAsync(
        bool notifyRenderer,
        bool waitForTurn,
        CancellationToken cancellationToken)
    {
        if (waitForTurn)
        {
            await _refreshGate
                .WaitAsync(
                    cancellationToken);
        }
        else if (!await _refreshGate
                     .WaitAsync(
                         millisecondsTimeout:
                             0,
                         cancellationToken))
        {
            return;
        }

        try
        {
            var workshopTask =
                ManagerClient
                    .GetWorkshopAsync(
                        cancellationToken)
                    .AsTask();

            var settingsTask =
                ManagerClient
                    .GetSettingsAsync(
                        cancellationToken)
                    .AsTask();

            await Task.WhenAll(
                workshopTask,
                settingsTask);

            var snapshot =
                await workshopTask;

            _animationTracker.Observe(
                snapshot);

            _snapshot =
                snapshot;

            _settings =
                await settingsTask;

            _lastRefreshUtc =
                DateTimeOffset.UtcNow;

            _error =
                null;
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Manager workshop refresh failed.");

            _error =
                ManagerWorkshopError.Connection;
        }
        finally
        {
            _refreshGate.Release();
        }

        if (notifyRenderer &&
            !cancellationToken.IsCancellationRequested)
        {
            await InvokeAsync(
                StateHasChanged);
        }
    }

    #endregion

    #region Methods Formatting

    private static string GetMonogram(
        string title) =>
        title
            .TrimStart()
            .FirstOrDefault()
            .ToString()
            .ToUpperInvariant();

    private string FormatScope(
        ManagerWorkItemScopeView scope) =>
        scope.Kind switch
        {
            ManagerWorkItemScopeKind.WholeDocument =>
                Localizer["WholeDocumentScope"],
            ManagerWorkItemScopeKind.PageRange =>
                Localizer[
                    "PageRangeScope",
                    scope.Title!,
                    scope.StartPhysicalPageNumber!,
                    scope.EndPhysicalPageNumber!],
            ManagerWorkItemScopeKind.ContentUnitRange =>
                Localizer[
                    "ContentUnitRangeScope",
                    scope.Title!,
                    scope.StartContentUnitIndex! + 1,
                    scope.EndContentUnitIndex! + 1],
            _ =>
                throw new ArgumentOutOfRangeException(
                    nameof(scope),
                    scope.Kind,
                    "Unknown Manager work-item scope kind.")
            };

    private static string GetRetryTextKey(
        ManagerWorkItemScopeView scope) =>
        scope.Kind != ManagerWorkItemScopeKind.WholeDocument
            ? "RetryBatch"
            : "RetryDocument";

    private static string GetRetryLabelKey(
        ManagerWorkItemScopeView scope) =>
        scope.Kind != ManagerWorkItemScopeKind.WholeDocument
            ? "RetryBatchLabel"
            : "RetryDocumentLabel";

    private string FormatCompletedAt(
        DateTimeOffset value)
    {
        var local =
            value.ToLocalTime();

        return local.Date ==
               DateTimeOffset.Now.Date
            ? Localizer[
                "TodayAt",
                local.ToString(
                    "t",
                    CultureInfo.CurrentCulture)]
            : local.ToString(
                "g",
                CultureInfo.CurrentCulture);
    }

    #endregion

    #region Types

    private enum ManagerWorkshopError
    {
        Control,
        Connection,
        Queue,
        Settings
    }

    #endregion
}
