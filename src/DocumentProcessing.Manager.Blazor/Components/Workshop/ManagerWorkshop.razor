    private async Task LoadArchivePageAsync(
        int offset)
    {
        if (_archiveLoading)
        {
            return;
        }

        if (!TryCreateArchiveDateRange(
                out var fromUtc,
                out var beforeUtc))
        {
            _archiveFailure =
                Localizer["ArchiveDateRangeInvalid"];

            return;
        }

        _archiveLoading =
            true;

        _archiveFailure =
            null;

        try
        {
            _archivePage =
                await ManagerClient.SearchArchiveAsync(
                    new ManagerArchiveQuery(
                        _archiveTitleFilter,
                        fromUtc,
                        beforeUtc,
                        _archiveSort,
                        offset),
                    _lifetime.Token);
        }
        catch (OperationCanceledException)
            when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Manager archive search failed.");

            _archiveFailure =
                Localizer["ArchiveLoadFailed"];
        }
        finally
        {
            _archiveLoading =
                false;
        }
    }

    private bool TryCreateArchiveDateRange(
        out DateTimeOffset? fromUtc,
        out DateTimeOffset? beforeUtc)
    {
        fromUtc =
            null;

        beforeUtc =
            null;

        if (!TryParseArchiveDate(
                _archiveFromDate,
                addOneDay:
                    false,
                out fromUtc) ||
            !TryParseArchiveDate(
                _archiveToDate,
                addOneDay:
                    true,
                out beforeUtc))
        {
            return false;
        }

        return !fromUtc.HasValue ||
               !beforeUtc.HasValue ||
               fromUtc.Value <
               beforeUtc.Value;
    }

    private static bool TryParseArchiveDate(
        string? value,
        bool addOneDay,
        out DateTimeOffset? utcValue)
    {
        utcValue =
            null;

        if (string.IsNullOrWhiteSpace(
                value))
        {
            return true;
        }

        if (!DateOnly.TryParseExact(
                value,
                "yyyy-MM-dd",
                CultureInfo.InvariantCulture,
                DateTimeStyles.None,
                out var date))
        {
            return false;
        }

        if (addOneDay)
        {
            if (date ==
                DateOnly.MaxValue)
            {
                return false;
            }

            date =
                date.AddDays(
                    1);
        }

        var localDateTime =
            DateTime.SpecifyKind(
                date.ToDateTime(
                    TimeOnly.MinValue),
                DateTimeKind.Unspecified);

        utcValue =
            new DateTimeOffset(
                    localDateTime,
                    TimeZoneInfo.Local.GetUtcOffset(
                        localDateTime))
                .ToUniversalTime();

        return true;
    }

