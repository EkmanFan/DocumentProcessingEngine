    private async Task HandleDocumentSubmittedAsync(
        ManagerDocumentSubmissionNotice notice)
    {
        _receivedDocumentTitle =
            notice.OriginalFileName;

        _receptionSequence++;

        await RefreshAsync(
            notifyRenderer:
                false,
            waitForTurn:
                true,
            _lifetime.Token);

        try
        {
            var preview =
                await ManagerClient.GetSplitPreviewAsync(
                    notice.ProcessingUnitId,
                    _lifetime.Token);

            if (preview.SplitSuggested)
            {
                _splitPreview = preview;
                _splitRunAfterApply =
                    notice.RequestedBehavior == ManagerDocumentSubmissionBehavior.Run;
                return;
            }
        }
        catch (Exception exception)
        {
            Logger.LogDebug(exception, "Automatic split suggestion was unavailable.");
        }

        if (notice.RequestedBehavior == ManagerDocumentSubmissionBehavior.Run &&
            _snapshot is not null)
        {
            await ManagerClient.ReleaseProcessingUnitAsync(
                notice.ProcessingUnitId,
                _snapshot.QueueVersion,
                _lifetime.Token);

            await RefreshAsync(false, true, _lifetime.Token);
        }
    }

    private async Task OpenSplitAsync(ManagerWorkItemView item)
    {
        _commandRunning = true;

        try
        {
            _splitRunAfterApply =
                item.DispatchState == ManagerQueueItemDispatchState.Ready;

            if (_splitRunAfterApply)
            {
                if (_snapshot is null)
                {
                    return;
                }

                await ManagerClient.PrepareProcessingUnitSplitAsync(
                    item.UnitId,
                    _snapshot.QueueVersion,
                    _lifetime.Token);

                await RefreshAsync(false, true, _lifetime.Token);
            }

            _splitPreview =
                await ManagerClient.GetSplitPreviewAsync(item.UnitId, _lifetime.Token);
        }
        finally
        {
            _commandRunning = false;
        }
    }

    private async Task PrepareUploadedSplitAsync(InputFileChangeEventArgs eventArgs)
    {
        _commandRunning = true;

        try
        {
            var result =
                await UploadService.SubmitAsync(
                    eventArgs.File,
                    ManagerDocumentSubmissionBehavior.Shelve,
                    _lifetime.Token);

            var unitId = result.ProcessingUnitIds.Single();
            await RefreshAsync(false, true, _lifetime.Token);
            _splitRunAfterApply = false;
            _splitPreview = await ManagerClient.GetSplitPreviewAsync(unitId, _lifetime.Token);
        }
        finally
        {
            _commandRunning = false;
        }
    }

    private async Task CloseSplit()
    {
        var preview = _splitPreview;
        var release = _splitRunAfterApply;

        _splitPreview = null;
        _splitRunAfterApply = false;

        if (release && preview is not null && _snapshot is not null)
        {
            await ManagerClient.ReleaseProcessingUnitAsync(
                preview.UnitId,
                _snapshot.QueueVersion,
                _lifetime.Token);

            await RefreshAsync(false, true, _lifetime.Token);
        }
    }

    private async Task ApplySplitAsync(IReadOnlyList<ManagerSplitRangeDraft> ranges)
    {
        if (_splitPreview is null || _snapshot is null)
        {
            return;
        }

        _splitBusy = true;

        try
        {
            await ManagerClient.SplitPendingUnitAsync(
                _splitPreview.UnitId,
                _snapshot.QueueVersion,
                ranges,
                _splitRunAfterApply,
                _lifetime.Token);

            _splitPreview = null;
            await RefreshAsync(false, true, _lifetime.Token);
        }
        finally
        {
            _splitBusy = false;
        }
    }

