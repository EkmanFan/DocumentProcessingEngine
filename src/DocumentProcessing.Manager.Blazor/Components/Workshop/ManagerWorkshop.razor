    #region Methods Lifecycle

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync(
            notifyRenderer:
                false,
            waitForTurn:
                true,
            _lifetime.Token);

        _refreshTimer =
            new PeriodicTimer(
                Options.RefreshInterval);

        _refreshLoop =
            RefreshPeriodicallyAsync(
                _lifetime.Token);
    }

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (_lifetime.IsCancellationRequested)
        {
            return;
        }

        try
        {
            var module =
                await GetWorkshopModuleAsync(
                    _lifetime.Token);

            await module
                .InvokeVoidAsync(
                    "initializeActionMenus",
                    _lifetime.Token);

            if (_snapshot?.PendingItems.Count is > 0)
            {
                _workshopReference ??=
                    DotNetObjectReference.Create(
                        this);

                await module
                    .InvokeVoidAsync(
                        "initializeQueueReorder",
                        _lifetime.Token,
                        _queueList,
                        _workshopReference);
            }

            if (_snapshot?.CompletedItems.Count is > 0)
            {
                await module
                    .InvokeVoidAsync(
                        "initializeOverflowIndicator",
                        _lifetime.Token,
                        _completedScrollRegion);
            }
        }
        catch (OperationCanceledException)
            when (_lifetime.IsCancellationRequested)
        {
        }
        catch (JSDisconnectedException)
            when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Manager workshop browser-enhancement initialization failed. Core controls remain available.");
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _lifetime
            .CancelAsync();

        _refreshTimer?.Dispose();

        if (_refreshLoop is not null)
        {
            try
            {
                await _refreshLoop;
            }
            catch (OperationCanceledException)
            {
            }
        }

        if (_workshopModule is not null)
        {
            try
            {
                await _workshopModule
                    .InvokeVoidAsync(
                        "disposeActionMenus");

                await _workshopModule
                    .DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _workshopReference?.Dispose();

        _refreshGate.Dispose();
        _lifetime.Dispose();
    }

