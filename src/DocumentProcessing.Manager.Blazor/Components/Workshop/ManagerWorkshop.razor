@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@inject IManagerHostClient ManagerClient
@inject IManagerResultClient ResultClient
@inject DocumentProcessing.Manager.Blazor.Configuration.ManagerApiOptions Options
@inject ILogger<ManagerWorkshop> Logger
@inject IStringLocalizer<ManagerWorkshop> Localizer
@inject IJSRuntime JavaScript

<main class="workshop-shell">
    <header class="workshop-header">
        <div class="brand-block">
            <div class="brand-mark" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <div>
                <p class="eyebrow">DPEngine Manager</p>
                <h1>@Localizer["WorkshopTitle"]</h1>
            </div>
        </div>

        <div class="manager-toolbar">
            <div class="manager-state @StateCssClass" aria-live="polite">
                <span class="state-indicator" aria-hidden="true"></span>
                <span>@StateLabel</span>
            </div>

            <div class="control-group" aria-label="@(Localizer["ManagerControlsLabel"])">
                @if (_snapshot?.State == ManagerHostState.Stopped)
                {
                    <button class="control-button control-primary"
                            type="button"
                            disabled="@_commandRunning"
                            @onclick="() => ExecuteControlAsync(ManagerControlAction.Start)">
                        @Localizer["Start"]
                    </button>
                }
                else if (_snapshot?.State == ManagerHostState.Paused)
                {
                    <button class="control-button control-primary"
                            type="button"
                            disabled="@_commandRunning"
                            @onclick="() => ExecuteControlAsync(ManagerControlAction.Resume)">
                        @Localizer["Resume"]
                    </button>
                }
                else
                {
                    <button class="control-button control-primary"
                            type="button"
                            disabled="@(_commandRunning || _snapshot is null)"
                            @onclick="() => ExecuteControlAsync(ManagerControlAction.Pause)">
                        @Localizer["Pause"]
                    </button>
                }

                <button class="control-button control-secondary"
                        type="button"
                        disabled="@(_commandRunning || _snapshot is null || _snapshot.State == ManagerHostState.Stopped)"
                        @onclick="() => ExecuteControlAsync(ManagerControlAction.Stop)">
                    @Localizer["Stop"]
                </button>
            </div>
        </div>
    </header>

    @if (_error is not null)
    {
        <div class="connection-alert" role="alert">
            <div>
                <strong>@ErrorTitle</strong>
                <span>@ErrorMessage</span>
            </div>
            <button type="button" @onclick="RefreshFromUserAsync">@Localizer["Retry"]</button>
        </div>
    }

    <section class="workshop-grid" aria-busy="@(_snapshot is null)">
        <section class="work-column queue-column" aria-labelledby="queue-title">
            <div class="column-heading">
                <div>
                    <p class="column-kicker">@Localizer["PendingKicker"]</p>
                    <h2 id="queue-title">@Localizer["PendingTitle"]</h2>
                </div>
                <span class="count-badge">@PendingCount</span>
            </div>

            <div class="column-rule"></div>

            @if (_snapshot is null)
            {
                <div class="skeleton-list" aria-label="@(Localizer["QueueLoadingLabel"])">
                    <div></div>
                    <div></div>
                    <div></div>
                </div>
            }
            else if (_snapshot.PendingItems.Count == 0)
            {
                <div class="empty-state">
                    <span class="empty-icon" aria-hidden="true">✓</span>
                    <strong>@Localizer["QueueEmptyTitle"]</strong>
                    <p>@Localizer["QueueEmptyDetail"]</p>
                </div>
            }
            else
            {
                <ol class="work-list queue-list" @ref="_queueList">
                    @for (var index = 0; index < _snapshot.PendingItems.Count; index++)
                    {
                        var item = _snapshot.PendingItems[index];

                        <li @key="item.UnitId"
                            class="work-item pending-item"
                            data-queue-drop-unit-id="@item.UnitId">
                            <span class="queue-drag-handle"
                                  data-queue-drag-unit-id="@item.UnitId"
                                  title="@(Localizer["DragQueueItemLabel", item.DocumentTitle])"
                                  aria-hidden="true">⠿</span>
                            <span class="queue-position">@item.QueuePosition</span>
                            <div class="work-copy">
                                <strong title="@item.OriginalFileName">@item.DocumentTitle</strong>
                                <span>@FormatScope(item.Scope)</span>
                            </div>
                            <div class="queue-actions">
                                <div class="queue-metadata">
                                    <span class="dispatch-badge @(item.DispatchState == ManagerQueueItemDispatchState.Shelved ? "dispatch-shelved" : "dispatch-ready")">
                                        @(item.DispatchState == ManagerQueueItemDispatchState.Shelved
                                            ? Localizer["ShelvedStatus"]
                                            : Localizer["ReadyStatus"])
                                    </span>
                                    @if (item.AttemptNumber > 1)
                                    {
                                        <span class="attempt-badge">@Localizer["AttemptLabel", item.AttemptNumber]</span>
                                    }
                                </div>
                                <div class="queue-command-group">
                                    @if (item.DispatchState == ManagerQueueItemDispatchState.Shelved)
                                    {
                                        <button class="queue-run-button"
                                                type="button"
                                                disabled="@_commandRunning"
                                                title="@(Localizer["RunQueuedItemLabel", item.DocumentTitle])"
                                                aria-label="@(Localizer["RunQueuedItemLabel", item.DocumentTitle])"
                                                @onclick="() => ReleaseProcessingUnitAsync(item.UnitId)">
                                            @Localizer["RunQueuedItem"]
                                        </button>
                                    }
                                    <div class="queue-order-controls">
                                        <button type="button"
                                                disabled="@(_commandRunning || index == 0)"
                                                title="@(Localizer["MoveEarlierLabel", item.DocumentTitle])"
                                                aria-label="@(Localizer["MoveEarlierLabel", item.DocumentTitle])"
                                                @onclick="() => MoveQueueItemAsync(item.UnitId, -1)">↑</button>
                                        <button type="button"
                                                disabled="@(_commandRunning || index == _snapshot.PendingItems.Count - 1)"
                                                title="@(Localizer["MoveLaterLabel", item.DocumentTitle])"
                                                aria-label="@(Localizer["MoveLaterLabel", item.DocumentTitle])"
                                                @onclick="() => MoveQueueItemAsync(item.UnitId, 1)">↓</button>
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                </ol>
            }

            <footer class="column-footer">
                <span>@Localizer["GlobalQueue"]</span>
                <span>v@(QueueVersion)</span>
            </footer>
        </section>

        <section class="work-column active-column" aria-labelledby="active-title">
            <div class="column-heading active-heading">
                <div>
                    <p class="column-kicker">@Localizer["ActiveKicker"]</p>
                    <h2 id="active-title">@Localizer["ActiveTitle"]</h2>
                </div>
                @if (_snapshot?.ActiveItem is not null)
                {
                    <span class="live-badge"><span></span>@Localizer["ActiveBadge"]</span>
                }
            </div>

            <div class="current-document" aria-live="polite">
                @if (_snapshot?.ActiveItem is { } activeItem)
                {
                    <div class="document-monogram" aria-hidden="true">@GetMonogram(activeItem.DocumentTitle)</div>
                    <div>
                        <strong>@activeItem.DocumentTitle</strong>
                        <span>@FormatScope(activeItem.Scope)</span>
                    </div>
                }
                else
                {
                    <div class="document-monogram document-monogram-empty" aria-hidden="true">—</div>
                    <div>
                        <strong>@Localizer["NoActiveTitle"]</strong>
                        <span>@IdleMessage</span>
                    </div>
                }
            </div>

            <ManagerDocumentDropZone DocumentSubmitted="HandleDocumentSubmittedAsync">
                <LibrarianAnimation Mode="@LibrarianMode"
                                    DocumentTitle="@_snapshot?.ActiveItem?.DocumentTitle"
                                    CelebrationSequence="@_animationTracker.CelebrationSequence"
                                    ReceptionSequence="@_receptionSequence"
                                    ReceptionDocumentTitle="@_receivedDocumentTitle" />
            </ManagerDocumentDropZone>

            <footer class="active-footer">
                <span>@Localizer["SequentialProcessingDetail"]</span>
                <span>@LastRefreshLabel</span>
            </footer>
        </section>

        <section class="work-column completed-column" aria-labelledby="completed-title">
            <div class="column-heading">
                <div>
                    <p class="column-kicker">@Localizer["CompletedKicker"]</p>
                    <h2 id="completed-title">@Localizer["CompletedTitle"]</h2>
                </div>
                <span class="count-badge count-complete">@CompletedCount</span>
            </div>

            <div class="column-rule"></div>

            @if (_snapshot is null)
            {
                <div class="skeleton-list" aria-label="@(Localizer["CompletedLoadingLabel"])">
                    <div></div>
                    <div></div>
                    <div></div>
                </div>
            }
            else if (_snapshot.CompletedItems.Count == 0)
            {
                <div class="empty-state">
                    <span class="empty-icon empty-icon-book" aria-hidden="true">◇</span>
                    <strong>@Localizer["NoResultsTitle"]</strong>
                    <p>@Localizer["NoResultsDetail"]</p>
                </div>
            }
            else
            {
                <ol class="work-list completed-list">
                    @foreach (var item in _snapshot.CompletedItems)
                    {
                        <li class="work-item completed-item @(item.Status == ManagerQueueItemStatus.Failed ? "failed-item" : null)">
                            <span class="result-indicator" aria-hidden="true">
                                @(item.Status == ManagerQueueItemStatus.Failed ? "!" : "✓")
                            </span>
                            <div class="work-copy">
                                <strong title="@item.OriginalFileName">@item.DocumentTitle</strong>
                                <span>@FormatScope(item.Scope)</span>
                                <time datetime="@item.UpdatedAtUtc.ToString("O")">@FormatCompletedAt(item.UpdatedAtUtc)</time>
                                @if (item.Status == ManagerQueueItemStatus.Failed)
                                {
                                    <span class="processing-failure-message"
                                          title="@(Localizer["ProcessingFailureLabel", item.FailureMessage!])">
                                        @item.FailureMessage
                                    </span>
                                }
                            </div>
                            <div class="result-actions">
                                <span class="result-status">
                                    @(item.Status == ManagerQueueItemStatus.Failed
                                        ? Localizer["FailedStatus"]
                                        : Localizer["CompletedStatus"])
                                </span>
                                @if (item.Status == ManagerQueueItemStatus.Succeeded)
                                {
                                    <button class="result-download-button"
                                            type="button"
                                            disabled="@(_downloadingResultUnitId is not null)"
                                            title="@(Localizer["DownloadResultLabel", item.DocumentTitle])"
                                            aria-label="@(Localizer["DownloadResultLabel", item.DocumentTitle])"
                                            @onclick="() => DownloadResultAsync(item)">
                                        @(_downloadingResultUnitId == item.UnitId
                                            ? Localizer["DownloadingResult"]
                                            : Localizer["DownloadResult"])
                                    </button>
                                    @if (_resultDownloadFailureUnitId == item.UnitId)
                                    {
                                        <span class="result-download-error" role="alert">
                                            @_resultDownloadFailureMessage
                                        </span>
                                    }
                                }
                            </div>
                        </li>
                    }
                </ol>
            }

            <footer class="column-footer">
                <span>@Localizer["MostRecentFirst"]</span>
                <span>@CompletedResultCountLabel</span>
            </footer>
        </section>
    </section>
</main>

@code {
    #region Variables and Constants

    private readonly CancellationTokenSource
        _lifetime =
            new();

    private const string
        EmbeddedResultDownloadModulePath =
            "./_content/DocumentProcessing.Manager.Blazor/js/manager-result-download.js";

    private const string
        StandaloneResultDownloadModulePath =
            "./js/manager-result-download.js";

    private readonly ManagerWorkshopAnimationTracker
        _animationTracker =
            new();

    private readonly SemaphoreSlim
        _refreshGate =
            new(
                initialCount:
                    1,
                maxCount:
                    1);

    private ManagerWorkshopSnapshot?
        _snapshot;

    private PeriodicTimer?
        _refreshTimer;

    private Task?
        _refreshLoop;

    private ManagerWorkshopError?
        _error;

    private DateTimeOffset?
        _lastRefreshUtc;

    private bool
        _commandRunning;

    private Guid?
        _downloadingResultUnitId;

    private Guid?
        _resultDownloadFailureUnitId;

    private string?
        _resultDownloadFailureMessage;

    private IJSObjectReference?
        _workshopModule;

    private DotNetObjectReference<ManagerWorkshop>?
        _workshopReference;

    private ElementReference
        _queueList;

    private string?
        _receivedDocumentTitle;

    private long
        _receptionSequence;

    #endregion

    #region Properties

    private int PendingCount =>
        _snapshot?.PendingItems.Count ??
        0;

    private int ReadyPendingCount =>
        _snapshot?.PendingItems.Count(
            item =>
                item.DispatchState ==
                ManagerQueueItemDispatchState.Ready) ??
        0;

    private int CompletedCount =>
        _snapshot?.CompletedItems.Count ??
        0;

    private string CompletedResultCountLabel =>
        CompletedCount ==
        1
            ? Localizer[
                "ResultCountSingular",
                CompletedCount]
            : Localizer[
                "ResultCountPlural",
                CompletedCount];

    private long QueueVersion =>
        _snapshot?.QueueVersion ??
        0;

    private static string ResultDownloadModulePath =>
        System.Reflection.Assembly.GetEntryAssembly() ==
        typeof(ManagerWorkshop).Assembly
            ? StandaloneResultDownloadModulePath
            : EmbeddedResultDownloadModulePath;

    private string StateCssClass =>
        _snapshot?.State switch
        {
            ManagerHostState.Running =>
                "state-running",
            ManagerHostState.Paused =>
                "state-paused",
            ManagerHostState.Stopped =>
                "state-stopped",
            _ =>
                "state-unknown"
        };

    private string StateLabel =>
        _snapshot?.State switch
        {
            ManagerHostState.Running =>
                Localizer["StateRunning"],
            ManagerHostState.Paused =>
                Localizer["StatePaused"],
            ManagerHostState.Stopped =>
                Localizer["StateStopped"],
            _ =>
                Localizer["StateConnecting"]
        };

    private string ErrorTitle =>
        _error switch
        {
            ManagerWorkshopError.Queue =>
                Localizer["QueueUpdateFailedTitle"],
            _ =>
                Localizer["ManagerUnavailableTitle"]
        };

    private string IdleMessage =>
        _snapshot?.State switch
        {
            ManagerHostState.Paused =>
                Localizer["IdlePaused"],
            ManagerHostState.Stopped =>
                Localizer["IdleStopped"],
            _ when ReadyPendingCount > 0 =>
                Localizer["IdlePending"],
            _ when PendingCount > 0 =>
                Localizer["IdleShelved"],
            _ =>
                Localizer["IdleEmpty"]
        };

    private string LastRefreshLabel =>
        _lastRefreshUtc is null
            ? Localizer["Synchronizing"]
            : Localizer[
                "RefreshedAt",
                _lastRefreshUtc.Value
                    .ToLocalTime()
                    .ToString(
                        "T",
                        CultureInfo.CurrentCulture)];

    private string ErrorMessage =>
        _error switch
        {
            ManagerWorkshopError.Control =>
                Localizer["ControlFailedDetail"],
            ManagerWorkshopError.Connection =>
                Localizer["HostUnavailableDetail"],
            ManagerWorkshopError.Queue =>
                Localizer["QueueUpdateFailedDetail"],
            _ =>
                string.Empty
        };

    private LibrarianAnimationMode LibrarianMode =>
        _error is not null
            ? LibrarianAnimationMode.Unavailable
            : _snapshot?.State switch
            {
                null =>
                    LibrarianAnimationMode.Connecting,
                ManagerHostState.Stopped =>
                    LibrarianAnimationMode.Stopped,
                ManagerHostState.Paused =>
                    LibrarianAnimationMode.Paused,
                _ when _snapshot.ActiveItem is not null =>
                    LibrarianAnimationMode.Reading,
                _ =>
                    LibrarianAnimationMode.Waiting
            };

    #endregion

    #region Methods Lifecycle

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync(
            notifyRenderer:
                false,
            waitForTurn:
                true,
            _lifetime.Token);

        _refreshTimer =
            new PeriodicTimer(
                Options.RefreshInterval);

        _refreshLoop =
            RefreshPeriodicallyAsync(
                _lifetime.Token);
    }

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (_snapshot?.PendingItems.Count is not >
                0 ||
            _lifetime.IsCancellationRequested)
        {
            return;
        }

        try
        {
            _workshopReference ??=
                DotNetObjectReference.Create(
                    this);

            var module =
                await GetWorkshopModuleAsync(
                    _lifetime.Token);

            await module
                .InvokeVoidAsync(
                    "initializeQueueReorder",
                    _lifetime.Token,
                    _queueList,
                    _workshopReference);
        }
        catch (OperationCanceledException)
            when (_lifetime.IsCancellationRequested)
        {
        }
        catch (JSDisconnectedException)
            when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Manager queue pointer-reorder initialization failed. Arrow controls remain available.");
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _lifetime
            .CancelAsync();

        _refreshTimer?.Dispose();

        if (_refreshLoop is not null)
        {
            try
            {
                await _refreshLoop;
            }
            catch (OperationCanceledException)
            {
            }
        }

        if (_workshopModule is not null)
        {
            try
            {
                await _workshopModule
                    .DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _workshopReference?.Dispose();

        _refreshGate.Dispose();
        _lifetime.Dispose();
    }

    #endregion

    #region Methods Interaction

    private async Task HandleDocumentSubmittedAsync(
        string originalFileName)
    {
        _receivedDocumentTitle =
            originalFileName;

        _receptionSequence++;

        await RefreshAsync(
            notifyRenderer:
                false,
            waitForTurn:
                true,
            _lifetime.Token);
    }

    private async Task ExecuteControlAsync(
        ManagerControlAction action)
    {
        if (_commandRunning)
        {
            return;
        }

        _commandRunning =
            true;

        _error =
            null;

        try
        {
            await ManagerClient
                .ExecuteControlAsync(
                    action,
                    _lifetime.Token);

            await RefreshAsync(
                notifyRenderer:
                    false,
                waitForTurn:
                    true,
                _lifetime.Token);
        }
        catch (OperationCanceledException)
            when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Manager control command {ManagerControlAction} failed.",
                action);

            _error =
                ManagerWorkshopError.Control;
        }
        finally
        {
            _commandRunning =
                false;
        }
    }

    private async Task MoveQueueItemAsync(
        Guid unitId,
        int offset)
    {
        if (_commandRunning ||
            _snapshot is null ||
            offset is not (-1 or 1))
        {
            return;
        }

        var orderedUnitIds =
            _snapshot.PendingItems
                .Select(
                    item =>
                        item.UnitId)
                .ToList();

        var currentIndex =
            orderedUnitIds.IndexOf(
                unitId);

        var requestedIndex =
            currentIndex +
            offset;

        if (currentIndex <
                0 ||
            requestedIndex <
                0 ||
            requestedIndex >=
                orderedUnitIds.Count)
        {
            return;
        }

        (orderedUnitIds[currentIndex], orderedUnitIds[requestedIndex]) =
            (orderedUnitIds[requestedIndex], orderedUnitIds[currentIndex]);

        var expectedVersion =
            _snapshot.QueueVersion;

        await ExecuteQueueMutationAsync(
            cancellationToken =>
                ManagerClient.ReorderQueueAsync(
                    expectedVersion,
                    orderedUnitIds,
                    cancellationToken),
            "reorder");
    }

    /// <summary>
    /// Applies one pointer-based queue reorder requested by the browser adapter.
    /// </summary>
    [JSInvokable]
    public async Task ReorderQueueFromPointerAsync(
        string movingUnitId,
        string targetUnitId)
    {
        if (_commandRunning ||
            _snapshot is null ||
            !Guid.TryParse(
                movingUnitId,
                out var movingId) ||
            !Guid.TryParse(
                targetUnitId,
                out var targetId) ||
            movingId ==
                targetId)
        {
            return;
        }

        var expectedVersion =
            _snapshot.QueueVersion;

        IReadOnlyList<Guid> orderedUnitIds;

        try
        {
            orderedUnitIds =
                ManagerQueueOrder.MoveToTargetPosition(
                    _snapshot.PendingItems
                        .Select(
                            item =>
                                item.UnitId)
                        .ToArray(),
                    movingId,
                    targetId);
        }
        catch (ArgumentException exception)
        {
            Logger.LogWarning(
                exception,
                "Manager queue pointer-reorder referenced stale processing units.");

            _error =
                ManagerWorkshopError.Queue;

            return;
        }

        await ExecuteQueueMutationAsync(
            cancellationToken =>
                ManagerClient.ReorderQueueAsync(
                    expectedVersion,
                    orderedUnitIds,
                    cancellationToken),
            "drag-reorder");
    }

    private async Task DownloadResultAsync(
        ManagerWorkItemView item)
    {
        if (_downloadingResultUnitId is not null ||
            item.Status !=
                ManagerQueueItemStatus.Succeeded ||
            string.IsNullOrWhiteSpace(
                item.ResultReference))
        {
            return;
        }

        _downloadingResultUnitId =
            item.UnitId;

        _resultDownloadFailureUnitId =
            null;

        _resultDownloadFailureMessage =
            null;

        using var timeout =
            CancellationTokenSource.CreateLinkedTokenSource(
                _lifetime.Token);

        timeout.CancelAfter(
            Options.ResultDownloadTimeout);

        try
        {
            await using var result =
                await ResultClient
                    .OpenResultAsync(
                        item.ResultReference,
                        timeout.Token);

            if (result is null)
            {
                SetResultDownloadFailure(
                    item.UnitId,
                    Localizer["ResultNotFoundError"]);

                return;
            }

            var module =
                await GetWorkshopModuleAsync(
                    timeout.Token);

            using var streamReference =
                new DotNetStreamReference(
                    result.Content,
                    leaveOpen:
                        true);

            await module
                .InvokeVoidAsync(
                    "downloadFile",
                    timeout.Token,
                    ManagerResultDownloadFileName.Create(
                        item.OriginalFileName,
                        item.Scope),
                    result.MediaType,
                    streamReference);
        }
        catch (OperationCanceledException)
            when (_lifetime.IsCancellationRequested)
        {
        }
        catch (OperationCanceledException)
        {
            SetResultDownloadFailure(
                item.UnitId,
                Localizer["ResultDownloadTimeoutError"]);
        }
        catch (JSDisconnectedException)
            when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Manager result download failed for processing unit {ProcessingUnitId}.",
                item.UnitId);

            SetResultDownloadFailure(
                item.UnitId,
                Localizer["ResultDownloadError"]);
        }
        finally
        {
            _downloadingResultUnitId =
                null;
        }
    }

    private void SetResultDownloadFailure(
        Guid unitId,
        string message)
    {
        _resultDownloadFailureUnitId =
            unitId;

        _resultDownloadFailureMessage =
            message;
    }

    private async ValueTask<IJSObjectReference> GetWorkshopModuleAsync(
        CancellationToken cancellationToken)
    {
        _workshopModule ??=
            await JavaScript
                .InvokeAsync<IJSObjectReference>(
                    "import",
                    cancellationToken,
                    ResultDownloadModulePath);

        return _workshopModule;
    }

    private Task ReleaseProcessingUnitAsync(
        Guid unitId)
    {
        if (_snapshot is null)
        {
            return Task.CompletedTask;
        }

        var expectedVersion =
            _snapshot.QueueVersion;

        return ExecuteQueueMutationAsync(
            cancellationToken =>
                ManagerClient.ReleaseProcessingUnitAsync(
                    unitId,
                    expectedVersion,
                    cancellationToken),
            "release");
    }

    private async Task ExecuteQueueMutationAsync(
        Func<CancellationToken, ValueTask> mutation,
        string operation)
    {
        if (_commandRunning)
        {
            return;
        }

        _commandRunning =
            true;

        _error =
            null;

        try
        {
            await mutation(
                _lifetime.Token);

            await RefreshAsync(
                notifyRenderer:
                    false,
                waitForTurn:
                    true,
                _lifetime.Token);
        }
        catch (OperationCanceledException)
            when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Manager queue {ManagerQueueOperation} failed.",
                operation);

            _error =
                ManagerWorkshopError.Queue;
        }
        finally
        {
            _commandRunning =
                false;
        }
    }

    private Task RefreshFromUserAsync() =>
        RefreshAsync(
            notifyRenderer:
                false,
            waitForTurn:
                true,
            _lifetime.Token);

    #endregion

    #region Methods Refresh

    private async Task RefreshPeriodicallyAsync(
        CancellationToken cancellationToken)
    {
        try
        {
            while (_refreshTimer is not null &&
                   await _refreshTimer.WaitForNextTickAsync(
                       cancellationToken))
            {
                await RefreshAsync(
                    notifyRenderer:
                        true,
                    waitForTurn:
                        false,
                    cancellationToken);
            }
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task RefreshAsync(
        bool notifyRenderer,
        bool waitForTurn,
        CancellationToken cancellationToken)
    {
        if (waitForTurn)
        {
            await _refreshGate
                .WaitAsync(
                    cancellationToken);
        }
        else if (!await _refreshGate
                     .WaitAsync(
                         millisecondsTimeout:
                             0,
                         cancellationToken))
        {
            return;
        }

        try
        {
            var snapshot =
                await ManagerClient
                    .GetWorkshopAsync(
                        cancellationToken);

            _animationTracker.Observe(
                snapshot);

            _snapshot =
                snapshot;

            _lastRefreshUtc =
                DateTimeOffset.UtcNow;

            _error =
                null;
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Manager workshop refresh failed.");

            _error =
                ManagerWorkshopError.Connection;
        }
        finally
        {
            _refreshGate.Release();
        }

        if (notifyRenderer &&
            !cancellationToken.IsCancellationRequested)
        {
            await InvokeAsync(
                StateHasChanged);
        }
    }

    #endregion

    #region Methods Formatting

    private static string GetMonogram(
        string title) =>
        title
            .TrimStart()
            .FirstOrDefault()
            .ToString()
            .ToUpperInvariant();

    private string FormatScope(
        ManagerWorkItemScopeView scope) =>
        scope.Kind switch
        {
            ManagerWorkItemScopeKind.WholeDocument =>
                Localizer["WholeDocumentScope"],
            ManagerWorkItemScopeKind.PageRange =>
                Localizer[
                    "PageRangeScope",
                    scope.Title!,
                    scope.StartPhysicalPageNumber!,
                    scope.EndPhysicalPageNumber!],
            _ =>
                throw new ArgumentOutOfRangeException(
                    nameof(scope),
                    scope.Kind,
                    "Unknown Manager work-item scope kind.")
        };

    private string FormatCompletedAt(
        DateTimeOffset value)
    {
        var local =
            value.ToLocalTime();

        return local.Date ==
               DateTimeOffset.Now.Date
            ? Localizer[
                "TodayAt",
                local.ToString(
                    "t",
                    CultureInfo.CurrentCulture)]
            : local.ToString(
                "g",
                CultureInfo.CurrentCulture);
    }

    #endregion

    #region Types

    private enum ManagerWorkshopError
    {
        Control,
        Connection,
        Queue
    }

    #endregion
}
