@implements IAsyncDisposable
@inject ManagerWorkshopUploadService UploadService
@inject DocumentProcessing.Manager.Blazor.Configuration.ManagerApiOptions Options
@inject ILogger<ManagerDocumentDropZone> Logger
@inject IStringLocalizer<ManagerDocumentDropZone> Localizer

<div class="animation-stage @UploadStateCssClass"
     aria-busy="@_uploading"
     @ondragenter="HandleDragEnter"
     @ondragleave="HandleDragLeave"
     @ondrop="HandleDrop">
    @ChildContent

    <div class="submission-behavior"
         role="group"
         aria-label="@(Localizer["SubmissionBehaviorLabel"])"
         title="@SubmissionBehaviorDescription">
        <button type="button"
                class="@SubmissionBehaviorButtonClass(ManagerDocumentSubmissionBehavior.Shelve)"
                aria-pressed="@FormatPressedState(ManagerDocumentSubmissionBehavior.Shelve)"
                disabled="@(_uploading || SubmissionBehaviorDisabled)"
                @onclick="() => SelectSubmissionBehaviorAsync(ManagerDocumentSubmissionBehavior.Shelve)"
                @onclick:stopPropagation="true">
            @Localizer["ShelveBehavior"]
        </button>
        <button type="button"
                class="@SubmissionBehaviorButtonClass(ManagerDocumentSubmissionBehavior.Run)"
                aria-pressed="@FormatPressedState(ManagerDocumentSubmissionBehavior.Run)"
                disabled="@(_uploading || SubmissionBehaviorDisabled)"
                @onclick="() => SelectSubmissionBehaviorAsync(ManagerDocumentSubmissionBehavior.Run)"
                @onclick:stopPropagation="true">
            @Localizer["RunBehavior"]
        </button>
    </div>

    <div class="page-range-editor"
         @onclick:stopPropagation="true">
        <label class="page-range-toggle">
            <input type="checkbox"
                   disabled="@_uploading"
                   @bind="_usePageRanges" />
            <span>@Localizer["PageRangeMode"]</span>
        </label>
        @if (_usePageRanges)
        {
            @foreach (var range in _pageRanges)
            {
                <div class="page-range-row" @key="range.Id">
                    <input type="text"
                           aria-label="@(Localizer["PageRangeTitle"])"
                           placeholder="@(Localizer["PageRangeTitle"])"
                           disabled="@_uploading"
                           @bind="range.Title" />
                    <input type="number"
                           min="1"
                           aria-label="@(Localizer["PageRangeStart"])"
                           placeholder="@(Localizer["PageRangeStart"])"
                           disabled="@_uploading"
                           @bind="range.StartPhysicalPageNumber" />
                    <input type="number"
                           min="1"
                           aria-label="@(Localizer["PageRangeEnd"])"
                           placeholder="@(Localizer["PageRangeEnd"])"
                           disabled="@_uploading"
                           @bind="range.EndPhysicalPageNumber" />
                    <button type="button"
                            title="@(Localizer["RemovePageRange"])"
                            disabled="@(_uploading || _pageRanges.Count == 1)"
                            @onclick="() => RemovePageRange(range)">−</button>
                </div>
            }
            <button type="button"
                    class="add-page-range"
                    disabled="@_uploading"
                    @onclick="AddPageRange">@Localizer["AddPageRange"]</button>
        }
    </div>

    <InputFile @key="_fileInputSequence"
               class="document-drop-input"
               aria-label="@(Localizer["DropInputLabel"])"
               accept=".pdf,.epub,application/pdf,application/epub+zip"
               disabled="@_uploading"
               OnChange="SubmitSelectedDocumentAsync" />

    <div class="drop-hint" aria-hidden="true">
        <span>＋</span>
        <strong>@Localizer["DropHint"]</strong>
    </div>

    @if (UploadFeedbackVisible)
    {
        <div class="drop-feedback"
             role="status"
             aria-live="polite">
            <span class="drop-feedback-icon" aria-hidden="true">@UploadFeedbackIcon</span>
            <span>
                <strong>@UploadFeedbackTitle</strong>
                <small>@UploadFeedbackDetail</small>
            </span>
        </div>
    }
</div>

@code {
    #region Variables and Constants

    private readonly CancellationTokenSource
        _lifetime =
            new();

    private bool
        _uploading;

    private ManagerDocumentDropState
        _uploadState;

    private ManagerDocumentDropError?
        _uploadError;

    private string?
        _uploadFileName;

    private string?
        _uploadErrorDetail;

    private long
        _fileInputSequence;

    private bool
        _usePageRanges;

    private readonly List<EditablePageRange>
        _pageRanges =
        [new EditablePageRange()];

    #endregion

    #region Parameters

    [Parameter]
    [EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback<string> DocumentSubmitted { get; set; }

    [Parameter]
    public ManagerDocumentSubmissionBehavior SubmissionBehavior { get; set; } =
        ManagerDocumentSubmissionBehavior.Shelve;

    [Parameter]
    public EventCallback<ManagerDocumentSubmissionBehavior> SubmissionBehaviorChanged { get; set; }

    [Parameter]
    public bool SubmissionBehaviorDisabled { get; set; }

    #endregion

    #region Properties

    private bool UploadFeedbackVisible =>
        _uploadState is
            ManagerDocumentDropState.Ready or
            ManagerDocumentDropState.Uploading or
            ManagerDocumentDropState.Failed;

    private string? UploadStateCssClass =>
        _uploadState switch
        {
            ManagerDocumentDropState.Ready =>
                "drop-ready",
            ManagerDocumentDropState.Uploading =>
                "drop-uploading",
            ManagerDocumentDropState.Failed =>
                "drop-failed",
            _ =>
                null
        };

    private string UploadFeedbackIcon =>
        _uploadState switch
        {
            ManagerDocumentDropState.Ready =>
                "↓",
            ManagerDocumentDropState.Uploading =>
                "…",
            ManagerDocumentDropState.Failed =>
                "!",
            _ =>
                string.Empty
        };

    private string UploadFeedbackTitle =>
        _uploadState switch
        {
            ManagerDocumentDropState.Ready =>
                Localizer["DropReadyTitle"],
            ManagerDocumentDropState.Uploading =>
                Localizer["UploadingTitle"],
            ManagerDocumentDropState.Failed =>
                Localizer["UploadFailedTitle"],
            _ =>
                string.Empty
        };

    private string UploadFeedbackDetail =>
        _uploadState switch
        {
            ManagerDocumentDropState.Ready =>
                Localizer["DropReadyDetail"],
            ManagerDocumentDropState.Uploading =>
                _uploadFileName ??
                Localizer["DefaultDocumentName"],
            ManagerDocumentDropState.Failed =>
                UploadErrorMessage,
            _ =>
                string.Empty
        };

    private string UploadErrorMessage =>
        !string.IsNullOrWhiteSpace(
            _uploadErrorDetail)
            ? _uploadErrorDetail
            : _uploadError switch
            {
                ManagerDocumentDropError.NoReadableContent =>
                    Localizer["UploadNoReadableContentError"],
                ManagerDocumentDropError.TooLarge =>
                    Localizer[
                        "UploadTooLargeError",
                        FormatByteSize(
                            Options.MaximumUploadBytes)],
                ManagerDocumentDropError.UnsupportedFormat =>
                    Localizer["UploadUnsupportedFormatError"],
                ManagerDocumentDropError.PageRangesRequirePdf =>
                    Localizer["UploadPageRangesRequirePdfError"],
                ManagerDocumentDropError.Rejected =>
                    Localizer["UploadRejectedError"],
                ManagerDocumentDropError.Connection =>
                    Localizer["UploadConnectionError"],
                _ =>
                    string.Empty
            };

    private string SubmissionBehaviorDescription =>
        SubmissionBehavior switch
        {
            ManagerDocumentSubmissionBehavior.Shelve =>
                Localizer["ShelveBehaviorDetail"],
            ManagerDocumentSubmissionBehavior.Run =>
                Localizer["RunBehaviorDetail"],
            _ =>
                string.Empty
        };

    #endregion

    #region Methods Lifecycle

    protected override void OnParametersSet()
    {
        if (!Enum.IsDefined(
                SubmissionBehavior))
        {
            throw new ArgumentOutOfRangeException(
                nameof(SubmissionBehavior),
                SubmissionBehavior,
                "Unknown default document submission behavior.");
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _lifetime
            .CancelAsync();

        _lifetime.Dispose();
    }

    #endregion

    #region Methods Interaction

    private async Task SelectSubmissionBehaviorAsync(
        ManagerDocumentSubmissionBehavior submissionBehavior)
    {
        if (_uploading ||
            SubmissionBehaviorDisabled ||
            submissionBehavior ==
                SubmissionBehavior)
        {
            return;
        }

        await SubmissionBehaviorChanged.InvokeAsync(
            submissionBehavior);
    }

    private string SubmissionBehaviorButtonClass(
        ManagerDocumentSubmissionBehavior submissionBehavior) =>
        SubmissionBehavior ==
        submissionBehavior
            ? "selected"
            : string.Empty;

    private string FormatPressedState(
        ManagerDocumentSubmissionBehavior submissionBehavior) =>
        (SubmissionBehavior ==
         submissionBehavior)
        .ToString()
        .ToLowerInvariant();

    private void HandleDragEnter()
    {
        if (_uploading)
        {
            return;
        }

        _uploadError =
            null;

        _uploadErrorDetail =
            null;

        _uploadState =
            ManagerDocumentDropState.Ready;
    }

    private void HandleDragLeave()
    {
        if (_uploadState ==
            ManagerDocumentDropState.Ready)
        {
            _uploadState =
                ManagerDocumentDropState.Idle;
        }
    }

    private void HandleDrop()
    {
        if (_uploadState ==
            ManagerDocumentDropState.Ready)
        {
            _uploadState =
                ManagerDocumentDropState.Idle;
        }
    }

    private async Task SubmitSelectedDocumentAsync(
        InputFileChangeEventArgs eventArgs)
    {
        if (_uploading)
        {
            return;
        }

        var file =
            eventArgs.File;

        if (!TryBuildPageRanges(
                out var pageRanges,
                out var pageRangeError))
        {
            _uploadErrorDetail =
                pageRangeError;

            _uploadState =
                ManagerDocumentDropState.Failed;

            return;
        }

        _uploading =
            true;

        _uploadError =
            null;

        _uploadErrorDetail =
            null;

        _uploadFileName =
            file.Name;

        _uploadState =
            ManagerDocumentDropState.Uploading;

        ManagerDocumentSubmissionResult result;

        try
        {
            result =
                await UploadService
                    .SubmitAsync(
                        file,
                        SubmissionBehavior,
                        cancellationToken:
                            _lifetime.Token,
                        pageRanges:
                            pageRanges);
        }
        catch (OperationCanceledException)
            when (_lifetime.IsCancellationRequested)
        {
            return;
        }
        catch (ManagerWorkshopUploadValidationException exception)
        {
            _uploadError =
                exception.Failure switch
                {
                    ManagerWorkshopUploadValidationFailure.NoReadableContent =>
                        ManagerDocumentDropError.NoReadableContent,
                    ManagerWorkshopUploadValidationFailure.TooLarge =>
                        ManagerDocumentDropError.TooLarge,
                    ManagerWorkshopUploadValidationFailure.UnsupportedFormat =>
                        ManagerDocumentDropError.UnsupportedFormat,
                    ManagerWorkshopUploadValidationFailure.PageRangesRequirePdf =>
                        ManagerDocumentDropError.PageRangesRequirePdf,
                    _ =>
                        throw new ArgumentOutOfRangeException(
                            nameof(exception),
                            exception.Failure,
                            "Unknown upload validation failure.")
                };

            _uploadState =
                ManagerDocumentDropState.Failed;

            return;
        }
        catch (ManagerSubmissionRejectedException exception)
        {
            Logger.LogWarning(
                exception,
                "Manager rejected document {DocumentFileName} with code {ManagerErrorCode}.",
                file.Name,
                exception.ManagerCode);

            _uploadError =
                exception.StatusCode ==
                System.Net.HttpStatusCode.RequestEntityTooLarge
                    ? ManagerDocumentDropError.TooLarge
                    : ManagerDocumentDropError.Rejected;

            _uploadErrorDetail =
                exception.Message;

            _uploadState =
                ManagerDocumentDropState.Failed;

            return;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(
                exception,
                "Manager document submission failed for {DocumentFileName}.",
                file.Name);

            _uploadError =
                exception.StatusCode ==
                System.Net.HttpStatusCode.RequestEntityTooLarge
                    ? ManagerDocumentDropError.TooLarge
                    : exception.StatusCode is null
                        ? ManagerDocumentDropError.Connection
                        : ManagerDocumentDropError.Rejected;

            _uploadState =
                ManagerDocumentDropState.Failed;

            return;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Manager document submission failed for {DocumentFileName}.",
                file.Name);

            _uploadError =
                ManagerDocumentDropError.Rejected;

            _uploadState =
                ManagerDocumentDropState.Failed;

            return;
        }
        finally
        {
            _uploading =
                false;

            _fileInputSequence++;
        }

        _uploadState =
            ManagerDocumentDropState.Idle;

        await DocumentSubmitted
            .InvokeAsync(
                result.OriginalFileName);
    }

    private void AddPageRange() =>
        _pageRanges.Add(
            new EditablePageRange());

    private void RemovePageRange(
        EditablePageRange range)
    {
        if (_pageRanges.Count > 1)
        {
            _pageRanges.Remove(
                range);
        }
    }

    private bool TryBuildPageRanges(
        out IReadOnlyList<ManagerPageRangeRequest>? pageRanges,
        out string? error)
    {
        pageRanges =
            null;

        error =
            null;

        if (!_usePageRanges)
        {
            return true;
        }

        if (_pageRanges.Any(
                range =>
                    string.IsNullOrWhiteSpace(range.Title) ||
                    range.StartPhysicalPageNumber <= 0 ||
                    range.EndPhysicalPageNumber < range.StartPhysicalPageNumber))
        {
            error =
                Localizer["PageRangeInvalid"];

            return false;
        }

        var ordered =
            _pageRanges
                .OrderBy(range => range.StartPhysicalPageNumber)
                .ToArray();

        if (ordered
            .Skip(1)
            .Zip(
                ordered,
                (current, previous) =>
                    current.StartPhysicalPageNumber <= previous.EndPhysicalPageNumber)
            .Any(overlaps => overlaps))
        {
            error =
                Localizer["PageRangeOverlap"];

            return false;
        }

        pageRanges =
            _pageRanges
                .Select(
                    range =>
                        new ManagerPageRangeRequest(
                            range.StartPhysicalPageNumber,
                            range.EndPhysicalPageNumber,
                            range.Title.Trim()))
                .ToArray();

        return true;
    }

    #endregion

    #region Methods Formatting

    private static string FormatByteSize(
        long byteLength)
    {
        const double bytesPerMegabyte =
            1024d *
            1024d;

        const double bytesPerGigabyte =
            bytesPerMegabyte *
            1024d;

        return byteLength >=
               bytesPerGigabyte
            ? $"{byteLength / bytesPerGigabyte:0.#} GB"
            : $"{byteLength / bytesPerMegabyte:0.#} MB";
    }

    #endregion

    #region Types

    private enum ManagerDocumentDropState
    {
        Idle,
        Ready,
        Uploading,
        Failed
    }

    private enum ManagerDocumentDropError
    {
        NoReadableContent,
        TooLarge,
        UnsupportedFormat,
        PageRangesRequirePdf,
        Rejected,
        Connection
    }

    private sealed class EditablePageRange
    {
        public Guid Id { get; } = Guid.NewGuid();

        public string Title { get; set; } = string.Empty;

        public int StartPhysicalPageNumber { get; set; } = 1;

        public int EndPhysicalPageNumber { get; set; } = 1;
    }

    #endregion
}
