{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documentprocessing.local/schemas/ocr-engine-result-v1.schema.json",
  "title": "Document Processing OCR Engine Benchmark Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "benchmarkId",
    "sourceSha256",
    "engine",
    "pages"
  ],
  "properties": {
    "schemaVersion": {
      "const": "document-processing-ocr-engine-result-v1"
    },
    "benchmarkId": {
      "type": "string",
      "minLength": 1
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "model",
        "backend",
        "device"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "performance": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "startupMilliseconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "processPeakWorkingSetBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "acceleratorPeakMemoryBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageNumber",
        "inputSha256",
        "status",
        "elapsedMilliseconds",
        "imageWidth",
        "imageHeight",
        "regions"
      ],
      "properties": {
        "pageNumber": {
          "type": "integer",
          "minimum": 1
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "Completed",
            "Failed"
          ]
        },
        "elapsedMilliseconds": {
          "type": "number",
          "minimum": 0
        },
        "imageWidth": {
          "type": "integer",
          "minimum": 1
        },
        "imageHeight": {
          "type": "integer",
          "minimum": 1
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/region"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "text",
        "confidence",
        "bounds"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "properties": {
        "left": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "top": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "right": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bottom": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
